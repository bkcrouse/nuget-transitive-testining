<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    <!-- NuGet Package Properties -->
    <PackageId>NuGetDemo.Services</PackageId>
    <Version>1.0.0</Version>
    <Authors>NuGetDemo</Authors>
    <Company>NuGetDemo</Company>
    <Description>Services library that depends on Utilities and Core - demonstrates diamond dependency</Description>
    <PackageProjectUrl>https://github.com/bkcrouse/nuget-transitive-testining</PackageProjectUrl>
    <RepositoryUrl>https://github.com/bkcrouse/nuget-transitive-testining</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- Project references to demonstrate diamond dependency -->
    <ProjectReference Include="../../Core/NuGetDemo.Core/NuGetDemo.Core.csproj" />
    <ProjectReference Include="../../Utilities/NuGetDemo.Utilities/NuGetDemo.Utilities.csproj" />
    
    <!-- Add a different version of Newtonsoft.Json to demonstrate version conflict -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
