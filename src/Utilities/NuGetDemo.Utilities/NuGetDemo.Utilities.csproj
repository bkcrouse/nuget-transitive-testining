<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    <!-- NuGet Package Properties -->
    <PackageId>NuGetDemo.Utilities</PackageId>
    <Version>1.0.0</Version>
    <Authors>NuGetDemo</Authors>
    <Company>NuGetDemo</Company>
    <Description>Utilities library that depends on Core - demonstrates transitive dependencies</Description>
    <PackageProjectUrl>https://github.com/bkcrouse/nuget-transitive-testining</PackageProjectUrl>
    <RepositoryUrl>https://github.com/bkcrouse/nuget-transitive-testining</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- Project reference to Core -->
    <ProjectReference Include="../../Core/NuGetDemo.Core/NuGetDemo.Core.csproj" />
  </ItemGroup>

</Project>
